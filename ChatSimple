def chatbot():
    print("Hello! I'm ChatSimple, How can I help you today?")

    while True:
        user_input=input("You: ").lower()

        if user_input in ["bye","goodbye","exit","quit"]:
            print("ChatSimple: Goodbye! Have a great day!")
            break

        elif "hello" in user_input or "hi" in user_input:
            print("ChatSimple: Hey! How can I assist you today?")

        elif "who are you" in user_input or "what are you" in user_input:
            print("ChatSimple: I am a simple chatbot based system created using Python")

        elif "time" in user_input:
            from datetime import datetime
            now = datetime.now().strftime("%H:%M:%S")
            print(f"ChatSimple: The current time is {now}")

        elif "weather" in user_input:
            print("ChatSimple: I'm not connected to the internet, so I can't fetch weather info right now.")

        elif "thank you" in user_input or "thanks" in user_input:
            print("ChatSimple: You're welcome!")

        else:
            print("ChatSimple: I'm sorry, I didn’t understand that. Could you rephrase?")

chatbot()
